# ================================================================
# 环境变量配置模板 —— 复制为本目录下的 .env 后填写 (不要提交 .env!)
#   PowerShell:  Copy-Item .env.example .env; notepad .env
# 格式: KEY=VALUE 每行一条, # 开头为注释
# 优先级: 系统环境变量 > .env > 代码内默认值
# 各前缀对应脚本: SDP_=shodan_pipeline  RC_=reclean
#                 SR_=send_reflect      GUI_=scan_gui
# ================================================================

# ---- shodan_pipeline.py (SDP_) ----
# Shodan 登录 Cookie (必填): 浏览器登录 shodan.io -> F12 -> 网络 ->
# 任选请求 -> 复制请求头 Cookie 的整段值
SDP_COOKIE=
#SDP_SEARCH_QUERY=port:1900      # 搜索参数, 如 port:53 / port:161 / ssdp
#SDP_MAX_ROUNDS=0                # 爬取轮数, 0 = 无限循环 (Ctrl-C 停止)
#SDP_POLL_INTERVAL=60,120        # 每轮爬取间隔秒数 (下限,上限)
#SDP_PAGE_INTERVAL=2,4           # 同一轮内 page 间隔秒数
#SDP_TIMEOUT=5                   # HTTP 超时秒数
#SDP_PORTS=auto                  # auto = 从搜索语句提取端口; 或手填 "1900,123"
#SDP_RATE=1000                   # masscan 每秒发包速率
#SDP_RETRIES=2                   # masscan 重发次数 (2 = 共发 3 次)
#SDP_WAIT=4.0                    # 体积比实测等待响应秒数 (SSDP 建议 4-5)
#SDP_MIN_TOTAL_RATIO=15.0        # 保留阈值: 总放大率达到该倍数才收录
#SDP_IFACE=                      # 本机物理网卡 IP, 留空自动检测 (有 VPN 时手动填)
#SDP_RATE_TEST=1                 # 是否测回包吞吐量 (0 关闭)
#SDP_RATE_TEST_DURATION=3.0      # 吞吐量测试时长秒数
#SDP_RATE_TEST_PPS=50            # 吞吐量测试每秒发包数
#SDP_KEPT_FILE=shodan_kept.json  # 合格 IP 汇总文件
#SDP_CACHE_FILE=_tested_cache.json  # 已测试 IP 缓存文件
#SDP_MASSCAN=                    # masscan.exe 路径覆盖

# ---- reclean.py (RC_) ----
#RC_MIN_TOTAL_RATIO=             # 全量重测阈值; 不设沿用 SDP_MIN_TOTAL_RATIO
#RC_MAX_DEAD_RATIO=0.7           # 断网保护: 无响应 IP 超该比例中止不写盘, 1 = 关闭

# ---- send_reflect.py (SR_) ----
#SR_DURATION=30                  # 发包持续秒数 (--duration 可覆盖)
#SR_BANDWIDTH=8.0                # 发包目标 Mbps (--bandwidth 可覆盖)
#SR_RATIO_RANGE=15,20            # 倍率筛选: "50"=≥50; "15,20"=闭区间; "50,"=≥50
#SR_SOURCE_IP=                   # 伪造源 IP (--source-ip 可覆盖), 留空=本机网卡
#SR_PORTS=auto                   # auto = 从选中记录汇总端口; 或手填 "1900,123"
#SR_IFACE=                       # 本机网卡 IP, 留空 masscan 自动选择
#SR_OFFLINE=0                    # 1 = 只走流程不真发包 (流程测试)
#SR_REFLECT_TAIL=10              # 测试模式收尾抓包秒数
#SR_KEPT_FILE=shodan_kept.json   # IP 汇总文件
#SR_MASSCAN=                     # masscan.exe 路径覆盖

# ---- scan_gui.py (GUI_) ----
#GUI_MASSCAN=                    # masscan.exe 路径覆盖
